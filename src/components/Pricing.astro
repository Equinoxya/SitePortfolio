---
import { Picture } from "astro:assets";
import { img } from "../lib/images";
import pricing from "../data/pricing.json";
import { tr, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const tilt = ["-rotate-2", "rotate-2", "-rotate-1"];
---

<section id="pricing" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <h2 class="section-title">{t("pricing.title")}</h2>
  <p class="mt-4 max-w-xl text-lg">{t("pricing.intro")}</p>

  <ul class="mt-14 grid gap-14 sm:grid-cols-3 sm:gap-8">
    {
      pricing.map((plan, i) => (
        <li class="flex flex-col items-center text-center">
          <figure class:list={["pinned m-0 w-3/5 sm:w-4/5", tilt[i % tilt.length], i % 2 && "tape-blue"]}>
            <Picture
              src={img(plan.example)}
              alt={`${t("pricing.example")}${lang === "fr" ? " : " : ": "}${tr(plan.name, lang).toLowerCase()}`}
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={70}
              widths={[200, 300, 400]}
              sizes="(min-width: 640px) 25vw, 60vw"
              class="aspect-[3/4] h-auto w-full object-cover"
            />
          </figure>
          <h3 class="mt-6 text-xl font-semibold">{tr(plan.name, lang)}</h3>
          <p class="hand -rotate-2 text-5xl leading-tight font-bold text-crayon">{tr(plan.price, lang)}</p>
          <p class="mt-1 max-w-[26ch]">{tr(plan.detail, lang)}</p>
        </li>
      ))
    }
  </ul>

  <div class="mt-14 flex justify-center">
    <a href="#contact" class="btn">{t("pricing.cta")}</a>
  </div>
</section>
