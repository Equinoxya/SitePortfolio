---
import { Picture } from "astro:assets";
import { img } from "../lib/images";
import pricing from "../data/pricing.json";
import SectionTitle from "./SectionTitle.astro";
import { tr, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const sep = lang === "fr" ? " : " : ": "; // espace avant les deux-points en français
---

<section id="pricing" class="mx-auto max-w-6xl px-4 py-20 sm:px-8">
  <SectionTitle>
    {t("pricing.title")}
    <p slot="aside" class="max-w-md text-base leading-relaxed text-muted">{t("pricing.intro")}</p>
  </SectionTitle>

  <ul class="mt-12 grid gap-10 sm:grid-cols-3 sm:gap-6">
    {
      pricing.map((plan, i) => (
        <li data-reveal style={`--d:${i * 110}ms`}>
          <figure class="m-0 max-w-[260px] sm:max-w-none">
            <Picture
              src={img(plan.example)}
              alt={`${t("pricing.example")}${sep}${tr(plan.name, lang).toLowerCase()}`}
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={70}
              widths={[240, 360, 480]}
              sizes="(min-width: 640px) 30vw, 100vw"
              class="aspect-[3/4] h-auto w-full object-cover"
            />
          </figure>
          <div class="mt-5 flex items-baseline justify-between gap-4 border-t border-line pt-4">
            <h3 class="text-lg font-medium tracking-tight">{tr(plan.name, lang)}</h3>
            <p class="shrink-0 text-lg font-medium tracking-tight">{tr(plan.price, lang)}</p>
          </div>
          <p class="mt-2 max-w-[34ch] leading-relaxed text-muted">{tr(plan.detail, lang)}</p>
        </li>
      ))
    }
  </ul>

  <div class="mt-14">
    <a href="#contact" class="btn">{t("pricing.cta")}</a>
  </div>
</section>
