---
import { Picture } from "astro:assets";
import { img } from "../lib/images";
import me from "../data/presentation.json";
import SectionTitle from "./SectionTitle.astro";
import { tr, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="mx-auto max-w-6xl px-4 py-20 sm:px-8">
  <SectionTitle>{t("about.title")}</SectionTitle>

  <div class="mt-12 grid gap-12 md:grid-cols-[minmax(0,280px)_1fr] md:gap-16">
    <figure class="m-0 max-w-[280px]" data-reveal>
      <Picture
        src={img(me.photo)}
        alt={tr(me.photoAlt, lang)}
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        quality={72}
        widths={[280, 420, 560]}
        sizes="(min-width: 768px) 280px, 100vw"
        class="aspect-[3/4] h-auto w-full object-cover"
      />
    </figure>

    <div data-reveal style="--d:120ms" class="max-w-[62ch] space-y-5 text-lg leading-relaxed text-muted">
      {me.description[lang].map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>
