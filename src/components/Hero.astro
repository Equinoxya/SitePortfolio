---
import { Picture } from "astro:assets";
import { img } from "../lib/images";
import works from "../data/portfolio.json";
import pricing from "../data/pricing.json";
import { tr, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const sep = lang === "fr" ? " : " : ": "; // espace avant les deux-points en français

// Les 4 dernières illustrations (index le plus haut) ouvrent la page
const latest = [...works].sort((a, b) => b.index - a.index).slice(0, 4);
---

<section id="top" class="mx-auto max-w-6xl px-4 pt-10 pb-20 sm:px-8 md:pt-20">
  <p class="label text-muted" data-reveal>{t("hero.role")}</p>

  <h1
    class="mt-6 max-w-3xl text-balance text-4xl leading-[1.08] font-medium tracking-tight sm:text-5xl lg:text-[3.75rem]"
    data-reveal
    style="--d:80ms"
  >
    {t("hero.title")}
  </h1>

  <div class="mt-8 flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
    <p class="max-w-md text-lg leading-relaxed text-muted" data-reveal style="--d:160ms">
      {t("hero.text")}
    </p>

    <div class="flex flex-wrap items-center gap-6" data-reveal style="--d:240ms">
      <a href="#pricing" class="btn">{t("hero.cta")}</a>
      <a href="#gallery" class="btn-ghost">{t("hero.gallery")}</a>
    </div>
  </div>

  <ul class="label mt-10 flex flex-wrap gap-x-6 gap-y-2 border-t border-line pt-5 text-muted" aria-label={t("hero.prices")} data-reveal style="--d:320ms">
    {
      pricing.map((p) => (
        <li>
          {tr(p.name, lang)}
          {sep}
          <span class="text-ink">{tr(p.price, lang)}</span>
        </li>
      ))
    }
  </ul>

  <ul class="mt-14 grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-4 md:gap-x-6" aria-label={t("hero.latest")}>
    {
      latest.map((w, i) => (
        <li data-reveal style={`--d:${400 + i * 90}ms`}>
          <figure class="m-0">
            <Picture
              src={img(w.image)}
              alt={tr(w.alt, lang)}
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={72}
              widths={[240, 360, 540, 720]}
              sizes="(min-width: 768px) 25vw, 45vw"
              class="aspect-[3/4] h-auto w-full object-cover"
            />
            <figcaption class="label mt-3 text-muted">{tr(w.title, lang)}</figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>
