---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === "en" ? "fr" : "en";

const links = [
  { href: "#gallery", label: t("nav.gallery") },
  { href: "#about", label: t("nav.about") },
  { href: "#pricing", label: t("nav.pricing") },
  { href: "#contact", label: t("nav.contact") },
];
---

<header
  id="site-header"
  class="relative top-0 z-40 border-b border-transparent bg-paper/85 backdrop-blur-sm transition-colors duration-300 data-[scrolled]:border-line md:sticky"
>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-8 gap-y-3 px-4 py-5 sm:px-8">
    <a href="#top" class="text-lg font-medium tracking-[0.12em] uppercase no-underline">Equipouet</a>
    <div class="flex items-center gap-6 sm:gap-8">
      <nav aria-label={t("nav.label")}>
        <ul class="label flex flex-wrap gap-x-5 gap-y-1 text-muted sm:gap-7">
          {
            links.map((l) => (
              <li>
                <a href={l.href} class="text-muted no-underline transition-colors hover:text-ink">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a
        href={getRelativeLocaleUrl(other)}
        hreflang={other}
        lang={other}
        aria-label={t("nav.switch")}
        class="label border border-line px-2.5 py-1.5 text-muted no-underline transition-colors hover:border-ink hover:text-ink"
      >
        {other.toUpperCase()}
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header")!;
  const onScroll = () => header.toggleAttribute("data-scrolled", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
