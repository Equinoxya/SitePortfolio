---
import SocialIcon from "./SocialIcon.astro";
import SectionTitle from "./SectionTitle.astro";
import me from "../data/presentation.json";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const socials = [
  { name: "x", label: "X", href: me.socials.x },
  { name: "bluesky", label: "Bluesky", href: me.socials.bluesky },
  { name: "instagram", label: "Instagram", href: me.socials.instagram },
  { name: "patreon", label: "Patreon", href: me.socials.patreon },
] as const;
---

<section id="contact" class="mx-auto max-w-6xl px-4 py-20 sm:px-8">
  <SectionTitle>{t("contact.title")}</SectionTitle>

  <div class="mt-12 grid gap-12 md:grid-cols-2 md:gap-16">
    <div data-reveal>
      <p class="max-w-md text-lg leading-relaxed text-muted">{t("contact.text")}</p>

      <div class="mt-8 flex flex-wrap items-center gap-6">
        <a href={`mailto:${me.email}`} class="btn">{me.email}</a>
        <button
          type="button"
          id="copy-email"
          data-email={me.email}
          data-copied={t("contact.copied")}
          data-fail={t("contact.copyFail")}
          class="btn-ghost cursor-pointer"
        >
          {t("contact.copy")}
        </button>
      </div>
      <p id="copy-status" class="label mt-2 h-6 text-accent" role="status" aria-live="polite"></p>
    </div>

    <div data-reveal style="--d:120ms">
      <p class="label text-muted">{t("contact.elsewhere")}</p>
      <ul class="mt-5 border-t border-line">
        {
          socials.map((s) => (
            <li class="border-b border-line">
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="flex items-center gap-3 py-4 font-medium text-ink no-underline transition-colors hover:text-accent"
              >
                <SocialIcon name={s.name} class="size-4" />
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById("copy-email") as HTMLButtonElement;
  const status = document.getElementById("copy-status")!;
  btn.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.email!);
      status.textContent = btn.dataset.copied!;
    } catch {
      status.textContent = btn.dataset.fail!;
    }
    setTimeout(() => (status.textContent = ""), 2500);
  });
</script>
