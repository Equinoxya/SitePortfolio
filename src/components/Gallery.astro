---
import { Picture, getImage } from "astro:assets";
import { img } from "../lib/images";
import works from "../data/portfolio.json";
import SectionTitle from "./SectionTitle.astro";
import { tr, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const sorted = [...works].sort((a, b) => b.index - a.index);
const categories = [...new Set(sorted.map((w) => w.category))];

// Version grand format pour la visionneuse
const items = await Promise.all(
  sorted.map(async (w) => ({
    ...w,
    title: tr(w.title, lang),
    alt: tr(w.alt, lang),
    full: (await getImage({ src: img(w.image), width: 900, format: "webp", quality: 82 })).src,
  })),
);
---

<section id="gallery" class="mx-auto max-w-6xl px-4 py-20 sm:px-8">
  <SectionTitle>
    {t("gallery.title")}
    {
      categories.length > 1 && (
        <div slot="aside" class="flex flex-wrap gap-x-5 gap-y-1" role="group" aria-label={t("gallery.filter")}>
          <button type="button" class="chip" data-filter="all" aria-pressed="true">
            {t("gallery.all")}
          </button>
          {categories.map((c) => (
            <button type="button" class="chip" data-filter={c} aria-pressed="false">
              {c}
            </button>
          ))}
        </div>
      )
    }
  </SectionTitle>

  <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 md:gap-x-6 lg:grid-cols-4">
    {
      items.map((w, i) => (
        <li class="work" data-category={w.category} data-reveal style={`--d:${(i % 4) * 80}ms`}>
          <button type="button" class="group block w-full cursor-zoom-in text-left" data-full={w.full} data-alt={w.alt} data-title={w.title}>
            <Picture
              src={img(w.image)}
              alt={w.alt}
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={70}
              widths={[240, 360, 540]}
              sizes="(min-width: 1024px) 270px, (min-width: 768px) 30vw, 45vw"
              class="aspect-[3/4] h-auto w-full object-cover transition-opacity duration-300 group-hover:opacity-85"
            />
            <span class="label mt-3 block text-muted transition-colors group-hover:text-ink">{w.title}</span>
          </button>
        </li>
      ))
    }
  </ul>

  <dialog
    id="lightbox"
    class="m-auto max-h-[94vh] w-[min(94vw,720px)] bg-transparent p-0 backdrop:bg-ink/95"
    aria-label={t("gallery.title")}
  >
   <div class="mx-auto w-fit">
    <figure class="m-0">
      <img src="" alt="" width="900" height="1200" class="mx-auto h-auto max-h-[74vh] w-auto max-w-full bg-transparent object-contain" />
      <figcaption class="label mt-4 flex items-baseline justify-between gap-4 text-white/70">
        <span data-caption></span>
        <span class="shrink-0" data-counter></span>
      </figcaption>
    </figure>

    <div class="mt-5 flex items-center justify-between">
      <div class="flex gap-2">
        <button type="button" class="nav-btn" data-step="-1" aria-label={t("gallery.prev")}>
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
            ><path d="M15 5l-7 7 7 7"></path></svg
          >
        </button>
        <button type="button" class="nav-btn" data-step="1" aria-label={t("gallery.next")}>
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
            ><path d="M9 5l7 7-7 7"></path></svg
          >
        </button>
      </div>
      <form method="dialog">
        <button class="label cursor-pointer px-1 py-2 text-white/70 transition-colors hover:text-white">{t("gallery.close")}</button>
      </form>
    </div>
   </div>
  </dialog>
</section>

<style>
  @reference "../styles/global.css";

  .chip {
    @apply label cursor-pointer border-b border-transparent pb-0.5 text-muted transition-colors hover:text-ink;
  }
  .chip[aria-pressed="true"] {
    @apply border-ink text-ink;
  }

  .nav-btn {
    @apply grid size-11 cursor-pointer place-items-center border border-white/25 text-white/70 transition-colors hover:border-white hover:text-white;
  }

  #lightbox[open] figure {
    animation: fade-in 0.3s ease-out;
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  // Filtres
  const chips = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const works = document.querySelectorAll<HTMLElement>(".work");
  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      const f = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      works.forEach((w) => (w.hidden = f !== "all" && w.dataset.category !== f));
    }),
  );

  // Visionneuse : précédent / suivant, flèches du clavier, glisser sur mobile
  const dialog = document.getElementById("lightbox") as HTMLDialogElement;
  const bigImg = dialog.querySelector("img")!;
  const caption = dialog.querySelector<HTMLElement>("[data-caption]")!;
  const counter = dialog.querySelector<HTMLElement>("[data-counter]")!;
  const all = [...document.querySelectorAll<HTMLButtonElement>(".work [data-full]")];
  const visible = () => all.filter((b) => !b.closest<HTMLElement>(".work")!.hidden);
  let current = 0;

  function show(index: number) {
    const list = visible();
    current = (index + list.length) % list.length;
    const btn = list[current];
    bigImg.src = btn.dataset.full!;
    bigImg.alt = btn.dataset.alt!;
    caption.textContent = btn.dataset.title!;
    counter.textContent = `${current + 1} / ${list.length}`;
  }

  all.forEach((btn) =>
    btn.addEventListener("click", () => {
      show(visible().indexOf(btn));
      dialog.showModal();
    }),
  );
  dialog.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((b) => b.addEventListener("click", () => show(current + Number(b.dataset.step))));
  dialog.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") show(current - 1);
    if (e.key === "ArrowRight") show(current + 1);
  });
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
  // Au retour, le focus revient sur le dessin affiché
  dialog.addEventListener("close", () => visible()[current]?.focus());

  let startX = 0;
  dialog.addEventListener("touchstart", (e) => (startX = e.touches[0].clientX), { passive: true });
  dialog.addEventListener("touchend", (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
  });
</script>
