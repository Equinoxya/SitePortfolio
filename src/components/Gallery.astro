---
import { Picture, getImage } from "astro:assets";
import { img } from "../lib/images";
import works from "../data/portfolio.json";

const sorted = [...works].sort((a, b) => b.index - a.index);
const categories = [...new Set(sorted.map((w) => w.category))];

// Version grand format pour la visionneuse
const items = await Promise.all(
  sorted.map(async (w) => ({
    ...w,
    full: (await getImage({ src: img(w.image), width: 712, format: "webp", quality: 80 })).src,
  })),
);
---

<section id="gallery" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 class="section-title">Gallery</h2>
    {
      categories.length > 1 && (
        <div class="flex flex-wrap gap-1" role="group" aria-label="Filter by category">
          <button type="button" class="chip" data-filter="all" aria-pressed="true">All</button>
          {categories.map((c) => (
            <button type="button" class="chip" data-filter={c} aria-pressed="false">{c}</button>
          ))}
        </div>
      )
    }
  </div>

  <ul class="mt-12 grid grid-cols-2 gap-x-5 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
    {
      items.map((w, i) => (
        <li class="work" data-category={w.category}>
          <button
            type="button"
            class:list={["pinned w-full cursor-zoom-in text-left", i % 2 && "tape-blue"]}
            data-full={w.full}
            data-alt={w.alt}
            data-title={w.title}
          >
            <Picture
              src={img(w.image)}
              alt={w.alt}
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              quality={70}
              widths={[240, 360, 540]}
              sizes="(min-width: 1024px) 260px, (min-width: 768px) 30vw, 45vw"
              class="aspect-[3/4] h-auto w-full object-cover"
            />
            <span class="hand mt-2 block text-center text-xl leading-tight text-bic sm:text-2xl">{w.title}</span>
          </button>
        </li>
      ))
    }
  </ul>

  <dialog id="lightbox" class="m-auto max-h-[92vh] w-[min(92vw,560px)] overflow-visible bg-transparent p-0 backdrop:bg-ink/75">
    <figure class="pinned m-0">
      <img src="" alt="" width="712" height="950" class="h-auto max-h-[76vh] w-full object-contain" />
      <figcaption class="hand mt-2 text-center text-3xl text-bic"></figcaption>
    </figure>
    <form method="dialog">
      <button class="btn absolute -top-5 -right-3 px-4 py-2 text-sm">Close</button>
    </form>
  </dialog>
</section>

<style>
  @reference "../styles/global.css";

  .chip {
    @apply rounded-md px-3 py-1.5 font-semibold text-ink transition-colors hover:text-crayon;
  }
  .chip[aria-pressed="true"] {
    @apply text-bic underline decoration-crayon decoration-wavy decoration-2 underline-offset-[6px];
  }

  /* Légères rotations, comme des dessins scotchés à la main */
  .work .pinned {
    transition:
      rotate 0.2s ease,
      scale 0.2s ease;
  }
  .work:nth-child(4n + 1) .pinned { rotate: -2deg; }
  .work:nth-child(4n + 2) .pinned { rotate: 1.5deg; }
  .work:nth-child(4n + 3) .pinned { rotate: -1deg; }
  .work:nth-child(4n + 4) .pinned { rotate: 2.5deg; }
  .work .pinned:hover,
  .work .pinned:focus-visible {
    rotate: 0deg;
    scale: 1.03;
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const works = document.querySelectorAll<HTMLElement>(".work");
  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      const f = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      works.forEach((w) => (w.hidden = f !== "all" && w.dataset.category !== f));
    }),
  );

  const dialog = document.getElementById("lightbox") as HTMLDialogElement;
  const bigImg = dialog.querySelector("img")!;
  const caption = dialog.querySelector("figcaption")!;
  document.querySelectorAll<HTMLButtonElement>("[data-full]").forEach((btn) =>
    btn.addEventListener("click", () => {
      bigImg.src = btn.dataset.full!;
      bigImg.alt = btn.dataset.alt!;
      caption.textContent = btn.dataset.title!;
      dialog.showModal();
    }),
  );
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
